<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand navbar-dark raceday-navbar">
            <div class="container">

                <a class="navbar-brand raceday-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    RACE<span>DAY</span>
                </a>

                <div class="navbar-collapse">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        @if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrollments"
                                   asp-action="Index">
                                    My Enrolments
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "Organizer")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="OrganizerEvents"
                                   asp-action="Index">
                                    My Events
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("JWTToken") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link raceday-logout"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link raceday-register"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Main content -->
    <main role="main" class="container raceday-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="raceday-footer">
        <div class="container text-center">
            <p>
                &copy; @DateTime.Now.Year RaceDay.
                Ready. Set. Race.
            </p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
