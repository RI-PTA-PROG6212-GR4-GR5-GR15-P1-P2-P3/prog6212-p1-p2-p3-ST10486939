@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model RaceDayPOE2.MVC.Models.ViewModels.LoginViewModel

@{
	ViewData["Title"] = "Login";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-5">

			<h2 class="text-center mb-4">Login to RaceDay</h2>

			@if(TempData["LoginMessage"] != null)
			{
				<div class="alert alert-info">
					@TempData["LoginMessage"]
				</div>
			}

			@if (TempData["RegistrationSuccess"] != null)
			{
				<div class="alert alert-success">
					@TempData["RegistrationSuccess"]
				</div>
			}

			<form asp-controller="Account" asp-action="Login" method="post">

				@Html.AntiForgeryToken()

			<div asp-validation-summary="ModelOnly" class="text-danger mb-3">
			</div>

			<div class="mb-3">
				<label asp-for="EmailAddress" class="form-label"></label>

				<input asp-for="EmailAddress" class="form-control" placeholder="Enter your email address" />

				<span asp-validation-for="EmailAddress" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Password" class="form-label"></label>

				<input asp-for="Password" class="form-control" placeholder="Enter your password" />

				<span asp-validation-for="Password" class="text-danger"></span>
			</div>

			<button type="submit" class="btn btn-primary">
				Login
			</button>

			</form>
		</div>
	</div>
</div>

@section Scripts {
@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}