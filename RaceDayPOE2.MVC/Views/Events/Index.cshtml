@model List<RaceDayPOE2.MVC.Models.ViewModels.EventViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-5">
    @if (TempData["EventSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["EventSuccess"]
        </div>
    }

    @if (TempData["EventError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["EventError"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (TempData["EnrollmentError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["EnrollmentError"]
            </div>
        }

        <h2>RaceDay Events</h2>

        <p class="text-muted">
            Explore upcoming running, walking and cycling events.
        </p>

        @if (Context.Session.GetString("UserRole") == "Organizer")
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-success">
                Create Event
            </a>
        }
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Location</th>
                        <th>Description</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Event Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventLocation</td>
                            <td>@item.Description</td>
                            <td>@item.Distance</td>
                            <td>@item.Type</td>

                            <td>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (Context.Session.GetString("UserRole") == "Participant")
                                {
                                    <form action="/Enrollments/Enroll" method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="EventID" value="@item.EventID" />

                                        <input type="hidden" name="CategoryID" value="@item.CategoryID" />

                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Enrol
                                        </button>

                                    </form>

                                    /*<form asp-controller="Enrollments" asp-action="Enroll" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"  name="EventID" value="@item.EventID" />

                                        <input type="hidden" name="CategoryID" value="@item.CategoryID" />

                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Enroll
                                        </button>
                                    </form>*/
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
        Back to Home
    </a>
</div>