@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	ViewData["Title"] = "Home";
}

<div class="container mt-5 text-center">
	<h1 class="display-4">Welcome to RaceDay!</h1>

	<p class="lead mt-3">
		Your platform for running, walking and cycling events.
	</p>

	<p class="mt-3">
		Join RaceDay app to discover running events, register for competitions and track your times.
	</p>

	@if (Context.Session.GetString("JWTToken") == null)
	{
		<div class="mt-4">
			<a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-3">
				Login
			</a>

			<a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg">
				Register
			</a>
		</div>
	}
	else
	{
		<div class="mt-4">
			<h4>Welcome, @Context.Session.GetString("UserName")!</h4>

			<p>
				Your role: @Context.Session.GetString("UserRole")
			</p>

			<a asp-controller="Events" asp-action="Index" class="btn btn-primary">
				View Events
			</a>

			<form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
				<button type="submit" class="btn btn-outline-danger">
					Logout
				</button>
			</form>
		</div>
	}
</div>