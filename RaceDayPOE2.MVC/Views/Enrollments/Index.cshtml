@model List<RaceDayPOE2.MVC.Models.ViewModels.MyEnrollmentsViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-5">
    <h2 class="mb-4">My Enrolled Events</h2>

    @if (TempData["EnrollmentSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["EnrollmentSuccess"]
        </div>
    }

    @if (TempData["EnrollmentError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["EnrollmentError"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
       <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Event ID</th>
                    <th>Enrolment ID</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var enrollment in Model)
                {
                    <tr>
                        <td>@enrollment.EventName</td>
                        <td>@enrollment.CategoryDescription</td>
                        <td>@enrollment.EventID</td>
                        <td>@enrollment.EntryID</td>
                    </tr>
                }
            </tbody>
       </table>
    }

    <a asp-controller="Events" asp-action="Index" class="btn btn-secondary mt-3">
        Back to Events
    </a>

</div>