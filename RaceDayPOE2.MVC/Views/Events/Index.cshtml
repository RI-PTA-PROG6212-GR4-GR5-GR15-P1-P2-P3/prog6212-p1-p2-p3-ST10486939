@model List<RaceDayPOE2.MVC.Models.ViewModels.EventViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>RaceDay Events</h2>
            <p class="text-muted">
                Explore upcoming running, walking and cycling events.
            </p>
        </div>

    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Location</th>
                        <th>Description</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Event Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>

                            <td>@item.EventLocation</td>

                            <td>@item.Description</td>

                            <td>@item.Distance</td>

                            <td>@item.Type</td>

                            <td>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
        Back to Home
    </a>

</div>